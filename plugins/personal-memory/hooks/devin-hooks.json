{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT:-.}/content/session-start.md\"",
            "statusMessage": "Loading Memco Personal Memory context...",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT:-.}/content/user-prompt.md\"",
            "statusMessage": "Checking Memco Personal Memory...",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
